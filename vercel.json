{
  "redirects": [
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-logo.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/future-home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'sha256-/iG05Fnc52Bk24d6a1GrCSagLh8aRp/jEjhSyTty1wQ=' 'sha256-50H9ObSKWGzQTMhhjKFp+EsE4z5rtdGV5N9SB/PNHII=' 'sha256-9nMLrxy9FwiW8gb9m2pot+XvvU2vw0i/qkkgRomYWZY=' 'sha256-BHJm5u+qKmDQWyFW+k3zQu8+ibymNCyLOGXBf/HJ0CA=' 'sha256-Kg4wttNGwA4/yro35kJLpaNK6kHhfdcMiBZnZEKTRfw=' 'sha256-L5oH+I9L+dgMJ42UkA2sbevDVnGeE+kX611Ml1UCAXU=' 'sha256-SEQ6JlgFjnB4D9W26cBkexk3yPsW6ItJfntyR+db89A=' 'sha256-WKa8zzwLjLH7hHg/NnnpS9TdWT/lR+ZI+bLzvjaN9ZM=' 'sha256-WskuxnRm9BJ7ezRVfX3G4NmQ5tqpLyxW3xhzU6rW3eA=' 'sha256-aAVORGrJl5G0+xTQaNlFTuzz4Kpd8rM0/S/GK7RvFXk=' 'sha256-eY6Bhp5sSz4bjkOTAyO+cV3qCpB0+Mf5LfPgbL2W/rk=' 'sha256-f0ZFZdS/UAkczidrqkqH7Nzw+nB57BCKFnRZXaVgU4c=' 'sha256-kCXS7txuaxzF4OWH4BCaqcgCowku9CqoaGCAfu1fE7g=' 'sha256-lmGVV00l+JLYaZl1Vv5vDLf9FQP1gYjQrV4QGJ+DwEI=' 'sha256-qNoR9GPFh1YGRhC0Tm3Wu8lpgaHZqMqChv2g0WFegs4=' 'sha256-xGhvY9KCdYOUkcVc/AdixwjDwF5CBimleF7Uj6lpoqU=' 'sha256-yxewgDD+FhqP7en4gPbcZAlWHGpm+DCP2KLCz9A6I/Y='; script-src-attr 'none'"
        }
      ]
    },
    {
      "source": "/assets/branding/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ]
}
